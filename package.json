{
  "name": "chess-trainer",
  "version": "0.1.0",
  "description": "A desktop chess trainer: play Stockfish at any Elo, solve millions of puzzles, and learn from beginner to expert.",
  "main": "./out/main/index.js",
  "author": "Greg",
  "license": "GPL-3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder --win --publish never",
    "puzzles:build": "node scripts/build-puzzle-db.mjs",
    "assets:pieces": "node scripts/fetch-piece-sets.mjs && node scripts/make-bunny-pieces.mjs",
    "assets:bunny": "node scripts/make-bunny-pieces.mjs",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:all": "npm run build && electron-builder --win --linux --publish never",
    "assets:icon": "electron scripts/icon/render-icon.mjs build/icon.svg build/icon.png 1024",
    "sounds:preview": "node scripts/preview-sounds.mjs",
    "web:assets": "node scripts/build-web-assets.mjs",
    "web:puzzles": "node scripts/build-web-puzzles.mjs",
    "web:dev": "vite --config vite.web.config.ts",
    "web:build": "tsc --noEmit -p tsconfig.web.json && vite build --config vite.web.config.ts",
    "web:preview": "vite preview --config vite.web.config.ts --port 4174",
    "web:cert": "node scripts/make-lan-cert.mjs",
    "web:serve": "node scripts/serve.mjs dist-web --https --port 8443 --http-port 8080",
    "web:serve:http": "node scripts/serve.mjs dist-web --port 8080",
    "web:icons": "node scripts/build-web-icons.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stockfish.js": "^10.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^7.1.14",
    "vite-plugin-pwa": "^1.3.0",
    "zustand": "^5.0.15"
  },
  "desktopName": "chess-trainer.desktop"
}
