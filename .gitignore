node_modules/
out/
release/importer/
release/

# Downloaded upstream data. Rebuild with:
#   curl -L -o assets/raw/lichess_db_puzzle.csv.zst https://database.lichess.org/lichess_db_puzzle.csv.zst
#   npm run puzzles:build
assets/raw/

# Generated from the dump; 3.2GB, far too large for version control.
resources/puzzles.db
# SQLite WAL sidecars, written whenever the database is opened.
resources/puzzles.db-shm
resources/puzzles.db-wal

# Downloaded binary, ~77MB.
resources/engine/

# Local TLS certificates for serving the web build on a LAN.
# The CA private key lives here; never commit it.
certs/
dist-web/

# Regenerated by `npm run web:assets` from src/renderer/public and
# node_modules, so CI rebuilds them rather than carrying copies.
src/web/public/pieces/
src/web/public/engine/

# TypeScript incremental build state.
*.tsbuildinfo

# Scratch page used to probe the browser engine's UCI support.
web-test/
